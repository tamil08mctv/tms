# .env - Keep this file secret! Add to .gitignore
DEBUG=True

# Database (you can keep as is or move to env later)
DB_NAME=tmsgroups_db
DB_USER=postgres
DB_PASSWORD=mctv@2002
DB_HOST=localhost
DB_PORT=5432

# S3 Settings - Fill these when ready for production
USE_S3=False
AWS_ACCESS_KEY_ID=your_real_access_key_here
AWS_SECRET_ACCESS_KEY=your_real_secret_key_here
AWS_STORAGE_BUCKET_NAME=tms-furniture-media-2025
AWS_S3_REGION_NAME=ap-south-2  # Mumbai - fastest for India

# Redis - Always True (runs on same server)
USE_REDIS=False

# Production hosts (add your domain later)
ALLOWED_HOSTS=localhost,127.0.0.1